{
  "info": {
    "_postman_id": "a1b2c3d4-booking-api-laravel",
    "name": "Booking API (Laravel Sanctum)",
    "description": "REST API for registration, login, services, available slots, and authenticated bookings.\n\nSet `base_url` to your app URL (e.g. http://localhost:8000). After **Register** or **Login**, the test script saves `token` for **Create booking**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"jane.customer@example.com\",\n  \"password\": \"Password1!\",\n  \"password_confirmation\": \"Password1!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            },
            "description": "Creates a user (customer role) and returns a Bearer token in `data.token`."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Returns `data.token` for use as Bearer token. Adjust email/password to match a seeded user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/services",
              "host": ["{{base_url}}"],
              "path": ["api", "services"]
            },
            "description": "Public list of services (`data.services`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Slots",
      "item": [
        {
          "name": "Get available slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/available-slots?staff_id=1&service_id=1&date=2026-03-27",
              "host": ["{{base_url}}"],
              "path": ["api", "available-slots"],
              "query": [
                {
                  "key": "staff_id",
                  "value": "1",
                  "description": "Existing staff id (staffs table)"
                },
                {
                  "key": "service_id",
                  "value": "1",
                  "description": "Existing service id"
                },
                {
                  "key": "date",
                  "value": "2026-03-27",
                  "description": "Y-m-d, must be today or later"
                }
              ]
            },
            "description": "Query params: staff_id, service_id, date. Response: `data.slots` (array of available start times)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staff_id\": 1,\n  \"service_id\": 1,\n  \"date\": \"2026-03-27\",\n  \"time\": \"09:00\",\n  \"status\": \"pending\",\n  \"notes\": \"Optional note for the booking.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"]
            },
            "description": "Requires `Authorization: Bearer {{token}}`. Run **Register** or **Login** first so `token` is set.\n\n- `time`: `H:i` (24h), e.g. \"09:30\"\n- `status`: optional, `pending` or `confirmed`\n- `notes`: optional"
          },
          "response": []
        }
      ]
    }
  ]
}
